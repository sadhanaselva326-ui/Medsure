# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/medsure_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Application
APP_NAME=MedSure Vision
DEBUG=true
# REQUIRED IN PRODUCTION - generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Optional separate admin API key (falls back to SECRET_KEY if not set)
ADMIN_API_KEY=

# API Keys
ABDM_API_KEY=your-abdm-api-key
EKA_CARE_API_KEY=your-eka-care-api-key
GS1_API_KEY=your-gs1-api-key

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://medsure.vision

# Logging
LOG_LEVEL=INFO

# Search Fuzzy Threshold (0.0 to 1.0)
FUZZY_THRESHOLD=0.3
